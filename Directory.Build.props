<Project>

  <!--
    Shared build settings. The Windows-only target framework and x64 platform are
    deliberate constraints (CLAUDE.md, PRD 5.1): System.DirectoryServices.ActiveDirectory
    and the msi.dll interop in Core are Windows-only at runtime, and the WinForms GUI
    added in Phase 5 requires the Windows Desktop targeting pack.

    TargetFramework tracks the highest installed LTS SDK, verified with the `dotnet list-sdks` command.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Version is hand-edited, by decision: there is no build server to derive one from, and a
    number an operator reads off a jump host should be one a human chose deliberately.

    It reaches three places that matter and are checked in the field:
      - the file's Details tab in Explorer, which is where someone confirms what they copied;
      - every run.log and validation.log header (RunLogWriter reads the assembly version);
      - the deployment_run rows recorded against a customer's domain controllers.
  -->
  <PropertyGroup>
    <Product>Hybrid Audit Agent Deployment Utility</Product>
    <Company>Quest Software</Company>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Copyright>Copyright © Quest Software</Copyright>

    <!-- PRD 3.2: this ships as a field utility, not as a supported Quest product. Stated in
         the binary's own metadata so it survives being copied away from its README. -->
    <Description>
      Deploys the Quest Identity Defense Hybrid Audit Agent to Active Directory domain
      controllers. Field utility - not a supported Quest product.
    </Description>
  </PropertyGroup>

</Project>
