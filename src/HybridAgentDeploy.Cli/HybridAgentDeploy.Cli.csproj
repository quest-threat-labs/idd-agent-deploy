<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Presentation only. All orchestration, validation, and state transitions live in Core
    (CLAUDE.md, PRD 5.2). If a code path can only be exercised through this project, it is in
    the wrong place.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>

    <!--
      NOT "hybridagentdeploy". The GUI publishes as HybridAgentDeploy.exe, and Windows
      filenames are case-insensitive, so the two would be the same file. Publishing both into
      one folder does not warn about this: the second publish silently overwrites the first,
      and the bundle ships with only one of the two programs in it. Found by publishing both
      and counting the executables.

      The GUI keeps the descriptive name because it is double-clicked; the CLI takes the short
      one because it is typed.
    -->
    <AssemblyName>hadeploy</AssemblyName>
    <RootNamespace>HybridAgentDeploy.Cli</RootNamespace>

    <!-- The CLI is the escape hatch for hosts with no desktop, including Server Core
         (PRD-OPEN-Q: Q5), so it must not depend on the Windows Desktop targeting pack. -->
    <UseWindowsForms>false</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HybridAgentDeploy.Core\HybridAgentDeploy.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HybridAgentDeploy.Cli.Tests" />
  </ItemGroup>

</Project>
